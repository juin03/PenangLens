# Client-side Google Maps key (Places Autocomplete + native maps).
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build/publish time.
# For EAS builds/updates set this as an EAS environment variable instead:
#   eas env:create --name EXPO_PUBLIC_GOOGLE_MAPS_API_KEY --value <key> --environment preview
# Restrict the key in Google Cloud Console (Places API + Android app restriction).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_client_maps_key_here
