# ── Azure OpenAI (REQUIRED — the LLM behind chat + itinerary generation) ─────
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_API_VERSION=2025-01-01-preview
# Chat/utility model (intent classification, guardrail, descriptions)
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
# Stronger model for itinerary planning + the refine agent
AZURE_OPENAI_REASONING_DEPLOYMENT=gpt-5.4-mini
# Optional: separate deployment for structured itinerary extraction
# AZURE_OPENAI_EXTRACT_DEPLOYMENT=gpt-4o-mini

# ── Google Maps Platform (REQUIRED for real itineraries) ─────────────────────
# Server key. Restrict to: Places API (New), Distance Matrix API, Geocoding API.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# Optional: separate key for Places calls (falls back to GOOGLE_MAPS_API_KEY)
# GOOGLE_PLACES_API_KEY=

# ── Google Gemini (REQUIRED for RAG + personalization embeddings) ────────────
GOOGLE_API_KEY=your_google_gemini_api_key_here
GOOGLE_EMBED_MODEL=gemini-embedding-001

# ── Azure AI Search (REQUIRED for RAG retrieval) ─────────────────────────────
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_KEY=your_search_admin_key
AZURE_TEXT_INDEX_NAME=penang-text-index
AZURE_USER_PROFILE_INDEX_NAME=penang-user-profile-index
AZURE_PLACE_PROFILE_INDEX_NAME=penang-place-profile-index

# ── Personalization embeddings ───────────────────────────────────────────────
PERSONALIZATION_EMBEDDING_PROVIDER=google
PERSONALIZATION_EMBEDDING_DIM=768

# ── Optional ─────────────────────────────────────────────────────────────────
# OpenWeatherMap (weather tool; mock data used if unset)
OPENWEATHER_API_KEY=your_openweather_api_key_here
# LLM-based scope guardrail layer (default on)
LLM_GUARDRAIL_ENABLED=true
# LangSmith observability
# LANGCHAIN_API_KEY=your_langsmith_api_key
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=penang-lens-agent

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Internal service auth (RECOMMENDED in production) ────────────────────────
# When set, all non-public endpoints require the X-Internal-Key header with this
# value. Set the same value in the admin-portal (AGENT_INTERNAL_KEY) so the BFF
# can call the Agent. Leave unset for local dev.
# AGENT_INTERNAL_KEY=long_random_shared_secret
