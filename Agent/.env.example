# Google Gemini API Key
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Google Maps Distance Matrix API Key
# Get your API key from: https://console.cloud.google.com/
# Note: This same key works for Google Places API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Places API Key (Optional - uses GOOGLE_MAPS_API_KEY if not set)
# Only set this if you want to use a different key for Places API
# GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# OpenWeatherMap API Key (Optional)
# Get your API key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# LangSmith Observability (Optional)
# Sign up at: https://smith.langchain.com/
# LANGCHAIN_API_KEY=your_langsmith_api_key
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=penang-lens-agent

# Logging
LOG_LEVEL=INFO

# Azure AI Search (shared service, separate indices)
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_KEY=your_search_admin_key
AZURE_TEXT_INDEX_NAME=penang-text-index
AZURE_USER_PROFILE_INDEX_NAME=penang-user-profile-index
AZURE_PLACE_PROFILE_INDEX_NAME=penang-place-profile-index

# Personalization embedding config
# Keep user/place embeddings on the same model + dimensionality.
PERSONALIZATION_EMBEDDING_PROVIDER=google
GOOGLE_EMBED_MODEL=gemini-embedding-001
PERSONALIZATION_EMBEDDING_DIM=768
