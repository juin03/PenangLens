# Google Gemini API Key
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Google Maps Distance Matrix API Key
# Get your API key from: https://console.cloud.google.com/
# Note: This same key works for Google Places API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Places API Key (Optional - uses GOOGLE_MAPS_API_KEY if not set)
# Only set this if you want to use a different key for Places API
# GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# OpenWeatherMap API Key (Optional)
# Get your API key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here
