# ── PostgreSQL via Prisma (REQUIRED) ─────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/penanglens
DIRECT_URL=postgresql://user:password@localhost:5432/penanglens

# ── Auth (REQUIRED) ──────────────────────────────────────────────────────────
# Sign/verify JWTs for the mobile app + admin login. Generate a long random string.
JWT_SECRET=change_me_to_a_long_random_string

# ── Downstream microservices ─────────────────────────────────────────────────
AGENT_URL=http://127.0.0.1:8000
VISION_ML_URL=http://127.0.0.1:8001

# ── Google Maps (admin map page — CLIENT key, baked into the JS bundle) ──────
# Restrict to Maps JavaScript API + Places API in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_client_maps_key_here

# ── Azure AI Search (spot indexing checks) ───────────────────────────────────
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_KEY=your_search_admin_key

# ── Azure Blob Storage (spot image uploads) ──────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...
AZURE_STORAGE_CONTAINER_NAME=spot-images

# ── Internal service auth (RECOMMENDED in production) ────────────────────────
# Must match AGENT_INTERNAL_KEY on the Agent service; sent as X-Internal-Key.
# AGENT_INTERNAL_KEY=long_random_shared_secret
